[
  {
    "id": "active_case_search",
    "name": "Active case search",
    "family": "surveillance",
    "description": "ASHAs go house to house in one village looking for fever with rash. Cases are found sooner and more of them are found.",
    "cost": {
      "budget": 2,
      "action_points": 1
    },
    "targets": "village",
    "effects": [
      {
        "op": "add_state",
        "key": "systems.surveillance",
        "where": "target",
        "amount": 0.6,
        "max": 1.0
      }
    ],
    "concepts": [
      "iceberg_phenomenon",
      "reporting_delay"
    ]
  },
  {
    "id": "sentinel_reporting",
    "name": "Strengthen weekly reporting",
    "family": "surveillance",
    "description": "Tighten weekly reporting from every sub-centre of one block. A smaller boost than a house-to-house search, but it covers the whole block.",
