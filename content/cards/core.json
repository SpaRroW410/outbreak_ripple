    "concepts": [
      "reporting_delay"
    ]
  },
  {
    "id": "contact_tracing",
    "name": "Contact tracing",
    "family": "investigation",
    "description": "List the contacts of known cases in one village and ask them to stay home while infectious. Works better where people trust the health team; fades over the weeks.",
    "cost": {
      "budget": 2,
      "action_points": 1
    },
    "targets": "village",
    "effects": [
      {
        "op": "add_state",
        "key": "infectious.tracing",
        "where": "target",
        "amount": 0.5,
        "max": 1.0
      }
    ],
    "concepts": [
      "contact_tracing"
    ]
  },
  {
    "id": "outbreak_investigation",
    "name": "Outbreak investigation",
    "family": "investigation",
    "description": "Send a team to verify the diagnosis and build a line list in one village. Pending cases are reported at once, so an outbreak can be recognised early.",
